# FORGE MIND -- Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Values marked [REQUIRED] MUST be changed before running in production.

# --- Application ---
# Environment: "development" | "production" | "test"
APP_ENV=development
RUST_LOG=forge_mind_api=debug,tower_http=debug,sqlx=warn

# Comma-separated list of allowed CORS origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=3001

# --- Database (PostgreSQL 16 + pgvector) ---
# [REQUIRED in production] Full PostgreSQL connection string
DATABASE_URL=postgres://forge_mind:forge_mind_pass@localhost:5432/forge_mind
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

# --- Cache / Queue (Redis 7) ---
REDIS_URL=redis://localhost:6379

# --- Authentication (RS256 JWT) ---
# Generate keypair:
#   openssl genpkey -algorithm RSA -out keys/jwt_private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in keys/jwt_private.pem -out keys/jwt_public.pem
# In production these MUST point to real key files (NOT the dev keys in this repo).
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- Object Storage (MinIO dev / Cloudflare R2 prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=forge-mind-demos
S3_ACCESS_KEY_ID=minioadmin
# [REQUIRED in production]
S3_SECRET_ACCESS_KEY=minioadmin

# --- ML Service ---
ML_SERVICE_URL=http://localhost:8001

# --- File Uploads ---
# Maximum demonstration video upload size in bytes (default 500 MB)
MAX_UPLOAD_BYTES=524288000

# --- Internal API Secret ---
# [REQUIRED] Shared secret used by the ML worker to call internal endpoints.
# Generate: openssl rand -hex 32
INTERNAL_API_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- ML Service env vars (prefix ML_) ---
ML_HOST=0.0.0.0
ML_PORT=8001
ML_REDIS_URL=redis://localhost:6379
ML_CORE_API_URL=http://localhost:3001
ML_EMBEDDING_MODEL=all-MiniLM-L6-v2
ML_EMBEDDING_DIM=384
ML_USE_GPU=false
ML_MOCK_INFERENCE=true
ML_LOG_LEVEL=info
# [REQUIRED -- must match INTERNAL_API_SECRET above]
ML_INTERNAL_API_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- Next.js Web App ---
NEXT_PUBLIC_API_URL=http://localhost:3001
