{
  "name": "forge-mind-v2",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @forge-mind/web dev",
    "build": "pnpm --filter @forge-mind/web build",
    "lint": "pnpm --filter @forge-mind/web lint",
    "typecheck": "pnpm --filter @forge-mind/web typecheck",
    "test": "pnpm --filter @forge-mind/web test",
    "test:unit": "pnpm --filter @forge-mind/web test:unit",
    "db:migrate": "cd apps/api && cargo sqlx migrate run",
    "db:seed": "bash scripts/seed.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
