# Aurevix web app -- local environment variables
# Copy this file to .env.local (gitignored) and fill in the values you need.
# .env.local is loaded automatically by Next.js and is NOT committed to git.

# --- LLM provider for /api/tasks/[id]/interpret ---
# Provider order:
#   1. Anthropic API key (Claude)          -- if ANTHROPIC_API_KEY is set
#   2. Claude Code CLI (your subscription) -- if `claude` is installed, no key
#   3. Ollama (local)                      -- if reachable
#   4. Deterministic fallback              -- always available
# Every provider that sees the demonstration video receives still frames
# sampled from it (ffmpeg), so the motion policy is derived from what the
# robot actually does on screen, not just the task title.

# Option 1: set an API key to make Claude the active interpreter.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Option 2: the local Claude Code CLI authenticates with your Claude Code
# subscription -- no API key needed. Used automatically when no API key is set
# and `claude` is on PATH. Set CLAUDE_CODE_CLI=0 to disable it.
CLAUDE_CODE_CLI=1
CLAUDE_CODE_MODEL=sonnet

# Option 3: used only if the above are unavailable.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
