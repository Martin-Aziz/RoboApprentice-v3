# Aurevix web app -- local environment variables
# Copy this file to .env.local (gitignored) and fill in the values you need.
# .env.local is loaded automatically by Next.js and is NOT committed to git.

# --- LLM provider for /api/tasks/[id]/interpret ---
# Provider order: Anthropic (Claude) -> Ollama -> deterministic fallback.
# Set ANTHROPIC_API_KEY to make Claude the active interpreter -- get a key
# from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Used only if ANTHROPIC_API_KEY is not set (or the Claude call fails).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
