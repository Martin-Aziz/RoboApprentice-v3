  <joint name="wrist_2_joint" type="revolute"><parent link="wrist_1_link"/><child link="wrist_2_link"/><origin xyz="0.09 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/><limit lower="-6.283" upper="6.283" effort="28" velocity="3.14"/></joint>
  <link name="wrist_2_link"><visual><geometry><cylinder radius="0.04" length="0.08"/></geometry><material name="ur_grey"/></visual></link>
