  <link name="forearm_link"><visual><origin xyz="0.196 0 0"/><geometry><box size="0.392 0.065 0.065"/></geometry><material name="ur_grey"/></visual></link>
  <joint name="wrist_1_joint" type="revolute"><parent link="forearm_link"/><child link="wrist_1_link"/><origin xyz="0.392 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-6.283" upper="6.283" effort="28" velocity="3.14"/></joint>
