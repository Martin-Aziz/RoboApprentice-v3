# ──────────────────────────────────────
# FORGE MIND — .gitignore
# ──────────────────────────────────────

# ─── Environment ──────────────────────
.env
.env.local
.env.*.local

# ─── Rust ─────────────────────────────
/target/
apps/api/target/
**/*.rs.bk
Cargo.lock

# ─── Node.js ─────────────────────────
node_modules/
.pnpm-store/

# ─── Swift / Xcode / desktop provider ───
**/.build/
**/.swiftpm/
**/DerivedData/
**/*.xcodeproj/xcuserdata/
LLM provider/.build/

# ─── Next.js ─────────────────────────
apps/web/.next/
apps/web/.aurevix-data/
apps/web/out/
apps/web/video-tmp-raw/
apps/web/Aurevix_Demo_Video.mp4
Precision_Gripper.mp4
apps/web/public/*.html
apps/web/public/test-data/

# Generated demo/report artifacts
docs/live-app-verification-*/
docs/demo-qa-screenshots-*/

# ─── Python ──────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
apps/ml-service/.venv/
*.egg-info/
dist/
.mypy_cache/
.ruff_cache/

# ─── Keys & Secrets ──────────────────
keys/
*.pem
*.key

# ─── IDE ─────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ─── Docker ──────────────────────────
docker-data/

# ─── Testing ─────────────────────────
coverage/
htmlcov/
.coverage
*.lcov

# ─── Build artifacts ─────────────────
*.log
*.tsbuildinfo
tmp/

# ─── Video files ─────────────────────
video/

# Local scratch + working test assets (do not commit)
/scratchpad/
/warehouse-multistep.mp4
